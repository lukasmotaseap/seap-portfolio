# =========================================
# 1. Dependências do React (Essencial)
# =========================================
node_modules/

# =========================================
# 2. Arquivos de Build (Opcional, mas recomendado)
# =========================================
# Ignoramos a pasta dist no Git porque ela é gerada apenas na sua 
# máquina para jogar na Hostinger. Não precisamos versioná-la.
dist/
dist-ssr/

# =========================================
# 3. Segurança e Logs
# =========================================
.env
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================================
# 4. Imagens de Teste do Backend
# =========================================
# Evita que as fotos que você testar na sua máquina subam para o GitHub
uploads/
api/uploads/
public/uploads/